<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared QoS profiles for the SCADA PoC.

  Profiles are grouped by DDS domain boundary, not by application role:
    - field::         field domain streams (sim <-> selector field participant)
    - presentation::  presentation domain streams (selector web participant <-> scada_web)

  Each profile names a stream contract and contains both reader and writer QoS
  for that stream when both endpoints exist. Applications choose the endpoint QoS
  they need from the same profile name:

    provider = dds.QosProvider("dds/qos/profiles.xml")
    writer_qos = provider.datawriter_qos_from_profile("field::idvalue")
    reader_qos = provider.datareader_qos_from_profile("field::idvalue")
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/current/rti_dds_qos_profiles.xsd">

  <!-- field:: - field domain streams -->
  <qos_library name="field">

    <!-- MetaData: state data pattern.
         Published once per tag at startup; late joiners must receive it.
         RELIABLE + TRANSIENT_LOCAL + KEEP_LAST(1) per instance. -->
    <qos_profile name="metadata">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
          <writer_depth>1</writer_depth>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datareader_qos>
    </qos_profile>

    <!-- IdValue: periodic field value stream.
         Writer retains a short transient window; readers keep only live current
         values so diagnostics and selector field readers do not replay history. -->
    <qos_profile name="idvalue">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
          <writer_depth>1</writer_depth>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>10</depth>
        </history>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
        <!-- DD-042: KEEP_LAST(1) is the bound, and it is deliberate. A depth
             above 1 would give burst headroom at the cost of correctness here:
             the selector decimates on arrival and forwards the FIRST eligible
             sample of a batch, so a deeper queue would put stale values on the
             display (architecture §3.3, "latest sample wins").

             There is therefore no resource_limits entry: max_samples_per_instance
             cannot bind under KEEP_LAST(1) and would only read as protection that
             is not there. Not keeping up is instead reported by the selector from
             DataReaderCacheStatus.replaced_dropped_sample_count, which counts
             exactly the unread samples this reader overwrote. SAMPLE_LOST and
             SAMPLE_REJECTED do not fire for local KEEP_LAST replacement. -->
      </datareader_qos>
    </qos_profile>

  </qos_library>


  <!-- presentation:: - presentation domain streams -->
  <qos_library name="presentation">

    <!-- SelectedValue: durable current-value stream from selector to scada_web.
         KEEP_LAST(1) retains the latest sample per uid for repeat REST reads and
         late joiners, including slow-changing values. -->
    <qos_profile name="selected_value">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
          <!-- DD-029 made this side RELIABLE, which means the boundary invariant
               (no soft-side congestion reaches the field side) is enforced by
               discipline rather than by construction. Three things enforce it:

               1. KEEP_LAST(1) below, so a slow reader cannot accumulate a queue
                  this writer must retain.
               2. An unlimited send window, stated explicitly below, so ACK
                  progress never throttles write().
               3. A short max_blocking_time, so that if 1 and 2 are ever
                  changed, write() fails fast instead of stalling the dispatch
                  thread. The selector catches the timeout, counts it, and
                  continues; it never retries inside the callback
                  (architecture §3.8 rule 2). -->
          <max_blocking_time>
            <sec>0</sec>
            <nanosec>100000000</nanosec>
          </max_blocking_time>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
          <writer_depth>1</writer_depth>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
        <!-- Stated, not inherited: this is the default, but it is the property
             the boundary depends on, so a future profile edit has to remove it
             deliberately rather than by picking up a strict-reliable snippet. -->
        <protocol>
          <rtps_reliable_writer>
            <min_send_window_size>LENGTH_UNLIMITED</min_send_window_size>
            <max_send_window_size>LENGTH_UNLIMITED</max_send_window_size>
          </rtps_reliable_writer>
        </protocol>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datareader_qos>
    </qos_profile>

    <!-- SelectedMetaData: durable catalogue stream from selector to scada_web.
         Metadata streams are TRANSIENT_LOCAL so late joiners receive the latest
         catalogue sample per uid. -->
    <qos_profile name="selected_metadata">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
          <!-- Same bounded-blocking contract as selected_value above. This is
               the topic scada_web's tag catalogue depends on, and it is served
               by durability now that DD-029 puts RELIABLE on both ends. -->
          <max_blocking_time>
            <sec>0</sec>
            <nanosec>100000000</nanosec>
          </max_blocking_time>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
          <writer_depth>1</writer_depth>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
        <protocol>
          <rtps_reliable_writer>
            <min_send_window_size>LENGTH_UNLIMITED</min_send_window_size>
            <max_send_window_size>LENGTH_UNLIMITED</max_send_window_size>
          </rtps_reliable_writer>
        </protocol>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datareader_qos>
    </qos_profile>

    <!-- ValueRequest: reliable command stream from scada_web to selector. -->
    <qos_profile name="value_request">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datareader_qos>
    </qos_profile>

  </qos_library>

</dds>
