<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared QoS profiles for the SCADA PoC.

  Two profile groups mirror the Purdue-model boundary:
    - sim::  field-side (Level 0/1) writers
    - web::  presentation-side (Level 2) readers

  Convention: profile names match the topic role, not the topic name, so
  the same profile works whether the topic is "PLC::MetaData" (direct) or
  "PLC::SelectedMetaData" (via selector).

  Usage from Python:
    provider = dds.QosProvider("dds/qos/profiles.xml")
    qos = provider.datawriter_qos("sim::metadata")
    qos = provider.datareader_qos("web::metadata")
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/current/rti_dds_qos_profiles.xsd">

  <!-- ═══════════════════════════════════════════════════════════════════
       sim:: — field-side writers (Level 0/1 → selector boundary)
       ═══════════════════════════════════════════════════════════════════ -->
  <qos_library name="sim">

    <!-- MetaData: state data pattern.
         Published once per tag at startup; late joiners must receive it.
         RELIABLE + TRANSIENT_LOCAL + KEEP_LAST(1) per instance. -->
    <qos_profile name="metadata">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datawriter_qos>
    </qos_profile>

    <!-- IdValue: periodic value stream.
         Published every scan cycle; no history needed.
         RELIABLE + VOLATILE + KEEP_LAST(1). -->
    <qos_profile name="idvalue">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datawriter_qos>
    </qos_profile>

  </qos_library>

  <!-- ═══════════════════════════════════════════════════════════════════
       web:: — presentation-side readers (selector → scada-web boundary)

       DD-029: web side is BEST_EFFORT except where noted.
       DD-042: IdValue reader is BEST_EFFORT to avoid backpressure.
       MetaData reader is the exception: RELIABLE + TRANSIENT_LOCAL to
       receive the catalogue on late join.
       ═══════════════════════════════════════════════════════════════════ -->
  <qos_library name="web">

    <!-- MetaData reader: must match the writer's durability to get history.
         RELIABLE + TRANSIENT_LOCAL + KEEP_LAST(1). -->
    <qos_profile name="metadata">
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datareader_qos>
    </qos_profile>

    <!-- IdValue reader: best-effort current-value stream (DD-029, DD-042).
         No backpressure on the selector; lost samples are superseded by
         the next periodic publish. -->
    <qos_profile name="idvalue">
      <datareader_qos>
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datareader_qos>
    </qos_profile>

    <!-- ValueRequest writer: reliable command channel (DD-023).
         RELIABLE + KEEP_ALL so commands queue in order. -->
    <qos_profile name="value_request">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datawriter_qos>
    </qos_profile>

  </qos_library>

</dds>
