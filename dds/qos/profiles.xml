<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared QoS profiles for the SCADA PoC.

  Profiles are grouped by DDS domain boundary, not by application role:
    - field::         field domain streams (sim <-> selector field participant)
    - presentation::  presentation domain streams (selector web participant <-> scada_web)

  Each profile names a stream contract and contains both reader and writer QoS
  for that stream when both endpoints exist. Applications choose the endpoint QoS
  they need from the same profile name:

    provider = dds.QosProvider("dds/qos/profiles.xml")
    writer_qos = provider.datawriter_qos_from_profile("field::idvalue")
    reader_qos = provider.datareader_qos_from_profile("field::idvalue")
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/current/rti_dds_qos_profiles.xsd">

  <!-- field:: - field domain streams -->
  <qos_library name="field">

    <!-- MetaData: state data pattern.
         Published once per tag at startup; late joiners must receive it.
         RELIABLE + TRANSIENT_LOCAL + KEEP_LAST(1) per instance. -->
    <qos_profile name="metadata">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
          <writer_depth>1</writer_depth>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datareader_qos>
    </qos_profile>

    <!-- IdValue: periodic field value stream.
         Writer retains a short transient window; readers keep only live current
         values so diagnostics and selector field readers do not replay history. -->
    <qos_profile name="idvalue">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
          <writer_depth>1</writer_depth>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>10</depth>
        </history>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
        <!-- DD-042: bounded resource limits give burst headroom without letting
             a stalled selector block the sim's writer indefinitely. Cache
             overflow becomes a logged sample_lost_status count, not silent. -->
        <resource_limits>
          <max_samples_per_instance>8</max_samples_per_instance>
        </resource_limits>
      </datareader_qos>
    </qos_profile>

  </qos_library>


  <!-- presentation:: - presentation domain streams -->
  <qos_library name="presentation">

    <!-- SelectedValue: durable current-value stream from selector to scada_web.
         KEEP_LAST(1) retains the latest sample per uid for repeat REST reads and
         late joiners, including slow-changing values. -->
    <qos_profile name="selected_value">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
          <!-- DD-028: a timeout is a logged drop, never a retry inside the
               dispatch callback, so a stalled scada_web reader cannot
               block the selector's field-side reception. -->
          <max_blocking_time>
            <sec>0</sec>
            <nanosec>100000000</nanosec>
          </max_blocking_time>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
          <writer_depth>1</writer_depth>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datareader_qos>
    </qos_profile>

    <!-- SelectedMetaData: durable catalogue stream from selector to scada_web.
         Metadata streams are TRANSIENT_LOCAL so late joiners receive the latest
         catalogue sample per uid. -->
    <qos_profile name="selected_metadata">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
          <max_blocking_time>
            <sec>0</sec>
            <nanosec>100000000</nanosec>
          </max_blocking_time>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
          <writer_depth>1</writer_depth>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>1</depth>
        </history>
      </datareader_qos>
    </qos_profile>

    <!-- ValueRequest: reliable command stream from scada_web to selector. -->
    <qos_profile name="value_request">
      <datawriter_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datawriter_qos>
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_ALL_HISTORY_QOS</kind>
        </history>
      </datareader_qos>
    </qos_profile>

  </qos_library>

</dds>
