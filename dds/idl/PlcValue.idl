
module PLC {
   
    const long MAX_STRING_VALUE_LENGTH = 32;     
    const long MAX_HOSTNAME_LENGTH = 32;   
	const long MAX_NAME_LENGTH = 32;

	// Domain IDs — single source of truth for all components.
	const long FIELD_DOMAIN_ID = 15;
	const long PRESENTATION_DOMAIN_ID = 16;

	typedef string<MAX_HOSTNAME_LENGTH> Hostname_t;  
	typedef string<MAX_NAME_LENGTH> Name_t;

	typedef long long ValueTime_t;
	typedef long UniqueId_t;      

	enum ValueKind_t {
		KIND_STRING,             
		KIND_INT32,             
		KIND_INT64,
		KIND_FLOAT32,
		KIND_FLOAT64             
	};
    
	@nested
 	union Value_t switch (ValueKind_t) {
	case KIND_STRING:
		char stringValue[MAX_STRING_VALUE_LENGTH];
	case KIND_INT32:
		long int32Value;
	case KIND_INT64:
		long long int64Value;
	case KIND_FLOAT32:
		float float32Value;
	case KIND_FLOAT64:
		double float64Value;
	};
    
	@nested
	struct Limits_t {
		Value_t redHigh;
		Value_t redLow;
		Value_t yellowHigh;
		Value_t yellowLow;
		Value_t greenHigh;
		Value_t greenLow;
		boolean active;
	};

    const string MetaDataTopic = "PLC::MetaDataTopic";
	// Use State Data QoS pattern, only sent at startup, typically
	struct MetaData {
		@key UniqueId_t   uid;
		ValueTime_t       valueTime;
		Hostname_t        hostname;
		Limits_t          limits;
		Name_t            longName;
	};

    const string IdValueTopic = "PLC::IdValueTopic";
	// Use 1-many reliable QoS pattern, perhaps batching, 
	// durability, reliability depends on whether all values update periodically or upon change
	struct IdValue {
		@key UniqueId_t   uid;
		ValueTime_t       valueTime;
		Value_t           smoothedValue;
		Value_t           rawValue;
	};

	// scada-selector output topics (DD-020, DD-028, DD-029). Same types as
	// their field-side counterparts -- IdValue in, IdValue out; MetaData in,
	// MetaData out -- on different topic names so a single-domain deployment
	// does not collide (scada-select-architecture.md §3.8).
	const string SelectedValueTopic = "PLC::SelectedValueTopic";
	const string SelectedMetaDataTopic = "PLC::SelectedMetaDataTopic";

	enum Command_t {
		ADD,
		DELETE,
		METADATA,
		PERIOD
	};

	@nested
	struct AddRequest_t {
		UniqueId_t     uid;
		Name_t         name;
	};

	@nested
	struct PeriodRequest_t {
		unsigned long  period_ms;
	};

    const string ValueRequestTopic = "PLC::ValueRequestTopic";
	// Sent by scada_web to scada_selector to select which values are
	// republished on the selected-value topic, and how often.
	//
	// ADD enables forwarding for a uid (by name). DELETE and METADATA act on
	// an existing uid. PERIOD sets the selector's global minimum separation
	// between forwarded samples: 0 means use the selector YAML default;
	// nonzero overrides the runtime setting. Instance lifecycle notifications
	// (dispose/unregister) are not rate limited.
	union ValueRequest switch (Command_t) {
	case ADD:
		AddRequest_t     addRequest;
	case DELETE:
	case METADATA:
		UniqueId_t       uid;
	case PERIOD:
		PeriodRequest_t  periodRequest;
	};

};
