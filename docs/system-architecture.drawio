        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ARROWS — connecting components to/from the databus             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- sim publishes to field bus -->
        <mxCell id="e-sim-bus0" value="" style="endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
