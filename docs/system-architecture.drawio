        <!-- IdValue topic connects down to bus -->
        <mxCell id="e-idval-bus0" value="" style="endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="280" as="sourcePoint" />
            <mxPoint x="160" y="295" as="targetPoint" />
