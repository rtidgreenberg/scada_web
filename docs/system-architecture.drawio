        <mxCell id="bus1" value="&lt;b&gt;&lt;font color=&quot;#ffffff&quot; style=&quot;font-size: 16px;&quot;&gt;DDS Domain 1 — Web Databus&lt;/font&gt;&lt;/b&gt;" style="shape=flexArrow;endArrow=classic;startArrow=none;html=1;rounded=0;endWidth=49;endSize=13;startWidth=49;startSize=0;width=38;fillColor=#f0a30a;strokeColor=#BD7000;" edge="1" parent="1">
