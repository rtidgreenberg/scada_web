        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- COMPONENTS — Rounded colored boxes (medtech style)             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- scada-sim -->
        <mxCell id="sim" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;scada-sim&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
